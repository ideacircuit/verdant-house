# GEMINI_API_KEY: Optional Gemini API key if AI features are added later.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PAYSTACK_SECRET_KEY: Required on the server for Paystack payment initialization, verification, and webhook signatures.
PAYSTACK_SECRET_KEY=

# ADMIN_PASSCODE: Optional server-side administrator passcode. If left empty, the Admin Studio prompts a one-time setup on first launch.
ADMIN_PASSCODE=
